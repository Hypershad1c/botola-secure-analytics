NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/botola_secure_analytics
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/botola_secure_analytics
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=bsa_session
LOG_LEVEL=info
OBSERVABILITY_TOKEN=replace-with-at-least-24-random-characters
ALLOW_DEV_ANALYTICS=true
INGESTION_WORKER_SHARED_SECRET=replace-in-local-only
# One-shot local/VM worker only; production workers should resolve object-storage references.
WORKER_INPUT_ROOT=./worker-input
# Optional grounded analyst provider; leave unset to keep the analyst disabled.
AI_API_BASE=
AI_API_KEY=
AI_MODEL=gpt-5-mini
